* text=auto
*.cs text eol=crlf
*.ps1 text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.png binary
*.webp binary
*.ico binary
*.gif binary
# Retain upstream formatting and ignore upstream whitespace in diff checks.
third_party/gridland/** -text -whitespace
third_party/webview2/*.txt -text -whitespace
third_party/adarkroom/www/** -text -whitespace
third_party/candybox2/www/** -text -whitespace
# Check our adapters normally; retain the upstream content and local attributes.
third_party/adarkroom/www/desktop.* text whitespace=blank-at-eol,blank-at-eof,space-before-tab
third_party/candybox2/www/desktop.* text whitespace=blank-at-eol,blank-at-eof,space-before-tab
